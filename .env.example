# environment variables
# Copy this file to .env and adjust values for your machine.
# The app runs correctly with these defaults — .env is optional.

# API server port
PORT=8000

# Frontend port
FRONTEND_PORT=5173

# Allowed frontend origin for CORS.
# Production: set to your deployed frontend URL.
CORS_ORIGIN=http://localhost:5173

BACKEND_ENVIRONMENT=development

VITE_API_PROXY_TARGET=http://backend:8000
